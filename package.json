{
  "name": "ha-ikio-cards",
  "private": true,
  "type": "module",
  "workspaces": [
    "cards/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run build:hacs",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "check:ikio-version": "node scripts/ikio-version.mjs --check",
    "package:ikio": "npm run check:ikio-version && node scripts/package-ikio.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "release:prepare": "npm run check:ikio-version && npm run preview:readme && npm run prepare:hacs && npm run check:hacs && npm run preview:check",
    "build:hacs": "node scripts/build-hacs.mjs",
    "prepare:hacs": "npm run build:hacs -- --write",
    "check:hacs": "node scripts/check-hacs.mjs",
    "preview:build": "node scripts/build-previews.mjs",
    "preview:generate": "node scripts/generate-previews.mjs",
    "test:browser": "node scripts/browser-checks.mjs",
    "preview:readme": "node scripts/update-readme-previews.mjs",
    "preview:check": "node scripts/update-readme-previews.mjs --check",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "devDependencies": {
    "@mdi/js": "7.4.47",
    "esbuild": "0.25.10",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "release-please": "17.11.2"
  }
}
